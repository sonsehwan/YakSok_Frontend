<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- 앱의 모든 화면이 밝은 색 기준으로 만들어져 있어 라이트로 고정한다.
         DayNight 를 쓰면 다크 모드에서 팝업, 다이얼로그, 메뉴처럼
         테마가 직접 그리는 부분만 어두워져 글자가 안 보이게 된다. -->
    <style name="Base.Theme.Medication" parent="Theme.Material3.Light.NoActionBar">
        <!-- 앱 화면이 상단바를 차지하지 않게 설정 -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Medication" parent="Base.Theme.Medication" />

    <!-- 사이드 메뉴 항목 글자를 키워서 아이콘과 균형을 맞춘다. -->
    <style name="TextAppearance.SideMenu.Item" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>