<?xml version="1.0" encoding="utf-8"?>
<!-- 체크 여부에 따라 아이콘과 색상이 변하는 선택자 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. 체크되었을 때 (복용 완료): 주황색 배경에 흰색 체크 아이콘 -->
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/p600" />
                    <size android:width="28dp" android:height="28dp" />
                </shape>
            </item>
            <item
                android:bottom="6dp"
                android:left="6dp"
                android:right="6dp"
                android:top="6dp"
                android:drawable="@drawable/ic_check" />
        </layer-list>
    </item>

    <!-- 2. 체크 안 되었을 때 (미복용): 흰 배경 + 회색 테두리 + 회색 체크 아이콘 -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@android:color/white" />
                    <size android:width="28dp" android:height="28dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/g300" />
                </shape>
            </item>
            <item
                android:bottom="6dp"
                android:left="6dp"
                android:right="6dp"
                android:top="6dp"
                android:drawable="@drawable/ic_check_gray" />
        </layer-list>
    </item>

</selector>