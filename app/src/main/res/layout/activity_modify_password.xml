<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/modify_password"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.myinfo.ModifyPassword">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:contentDescription="뒤로가기 버튼"
        android:src="@drawable/ic_lc_chevron_left"
        app:tint="@color/g900"
        app:layout_constraintBottom_toBottomOf="@+id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_header_title" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="비밀번호 변경"
        android:textColor="@color/g900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:lineSpacingMultiplier="1.36"
        android:text="현재 비밀번호를 확인하고\n새 비밀번호로 바꿔요"
        android:textColor="@color/g900"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/tv_header_title" />

    <LinearLayout
        android:id="@+id/ll_inputs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/tv_heading">

        <com.example.medication.InputView
            android:id="@+id/input_current_pw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:nextFocusDown="@id/input_new_pw"
            app:helperText="현재 비밀번호를 입력하세요."
            app:hintText="현재 비밀번호를 입력해 주세요"
            app:isPassword="true"
            app:labelText="현재 비밀번호"
            app:validationType="password" />

        <com.example.medication.InputView
            android:id="@+id/input_new_pw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:nextFocusDown="@id/input_check_pw"
            app:helperText="8~16자의 영문, 숫자, 특수문자를 모두 포함해야 합니다."
            app:hintText="새 비밀번호를 입력해 주세요"
            app:isPassword="true"
            app:labelText="새 비밀번호"
            app:validationType="password" />

        <com.example.medication.InputView
            android:id="@+id/input_check_pw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            app:helperText="새 비밀번호를 한 번 더 입력해주세요."
            app:hintText="새 비밀번호 확인을 입력해 주세요"
            app:isPassword="true"
            app:labelText="새 비밀번호 확인"
            app:validationType="password" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_relogin_note"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="변경이 끝나면 다시 로그인해 주세요"
        android:textColor="@color/g400"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_modify_pw"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_modify_pw"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="변경하기"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@color/p600"
        app:cornerRadius="12dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
