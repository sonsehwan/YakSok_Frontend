<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card_outlined"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_yaksok_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/g900"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="감기약 처방" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lc_chevron_right"
            app:tint="@color/g300" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_lc_calendar_days"
            app:tint="@color/g400" />

        <TextView
            android:id="@+id/tv_yaksok_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/g500"
            android:textSize="13sp"
            tools:text="2026-05-01 부터 3일간" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_badges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_badge_morning"
                style="@style/BadgeNeutral"
                android:text="아침" />

            <TextView
                android:id="@+id/tv_badge_lunch"
                style="@style/BadgeNeutral"
                android:layout_marginStart="6dp"
                android:text="점심" />

            <TextView
                android:id="@+id/tv_badge_dinner"
                style="@style/BadgeNeutral"
                android:layout_marginStart="6dp"
                android:text="저녁" />

            <TextView
                android:id="@+id/tv_badge_dosage"
                style="@style/BadgeNeutral"
                android:layout_marginStart="6dp"
                tools:text="식후 30분" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_yaksok_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/p600"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="75%" />
    </LinearLayout>

</LinearLayout>
