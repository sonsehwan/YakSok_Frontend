<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/create_prescription"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".ui.yaksok.CreatePrescription">

    <!-- 상단 헤더 영역 -->
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/g900"
        app:layout_constraintBottom_toBottomOf="@+id/tv_header_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_header_title" />

    <TextView
        android:id="@+id/tv_header_title"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="약속 등록"
        android:textColor="@color/g900"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_register"
        app:layout_constraintTop_toBottomOf="@id/tv_header_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 약속 명칭 섹션 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tv_label_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="약속 명칭 *"
                    android:textColor="@color/g700"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="*는 필수 항목이에요!"
                    android:textColor="@color/g400"
                    android:textSize="12sp" />
            </RelativeLayout>

            <com.example.medication.InputView
                android:id="@+id/input_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                app:hintText="약속 별명" />

            <!-- 투약 시작 날짜 / 투약일 수 (가로 배치) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="투약 시작 날짜 *"
                        android:textColor="@color/g700"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.example.medication.InputView
                        android:id="@+id/input_start_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        app:isReadOnly="true"
                        app:hintText="날짜 선택"
                        app:iconSrc="@drawable/ic_calendar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="투약일 수 *"
                        android:textColor="@color/g700"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.example.medication.InputView
                        android:id="@+id/input_prescriptionDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        app:hintText="예: 3" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="투약 횟수 *"
                android:textColor="@color/g700"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_dasage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="11dp"
                android:background="@drawable/bg_yellow_border"
                android:padding="2dp"
                android:weightSum="3">

                <CheckBox
                    android:id="@+id/cb_morning"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="아침"
                    android:button="@null"
                    android:drawableTop="@drawable/ic_lc_sunrise"
                    android:drawablePadding="2dp"
                    android:paddingVertical="8dp"
                    android:drawableTint="@color/selector_square_check_box_text"
                    android:gravity="center"
                    android:layout_margin="2dp"
                    android:background="@drawable/selector_square_check_box"
                    android:textSize="12sp"
                    android:textColor="@color/selector_square_check_box_text" />

                <CheckBox
                    android:id="@+id/cb_lunch"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="점심"
                    android:button="@null"
                    android:drawableTop="@drawable/ic_lc_sun"
                    android:drawablePadding="2dp"
                    android:paddingVertical="8dp"
                    android:drawableTint="@color/selector_square_check_box_text"
                    android:gravity="center"
                    android:layout_margin="2dp"
                    android:background="@drawable/selector_square_check_box"
                    android:textSize="12sp"
                    android:textColor="@color/selector_square_check_box_text" />

                <CheckBox
                    android:id="@+id/cb_dinner"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:text="저녁"
                    android:button="@null"
                    android:drawableTop="@drawable/ic_lc_moon"
                    android:drawablePadding="2dp"
                    android:paddingVertical="8dp"
                    android:drawableTint="@color/selector_square_check_box_text"
                    android:gravity="center"
                    android:layout_margin="2dp"
                    android:background="@drawable/selector_square_check_box"
                    android:textSize="12sp"
                    android:textColor="@color/selector_square_check_box_text" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <com.example.medication.InputView
                    android:id="@+id/input_set_morning_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:visibility="gone"
                    app:isReadOnly="true"
                    app:hintText="아침 알림(기본 08:00)"
                    app:iconSrc="@drawable/ic_time" />

                <com.example.medication.InputView
                    android:id="@+id/input_set_lunch_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:visibility="gone"
                    app:isReadOnly="true"
                    app:hintText="점심 알림(기본 12:00)"
                    app:iconSrc="@drawable/ic_time" />

                <com.example.medication.InputView
                    android:id="@+id/input_set_dinner_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="false"
                    android:visibility="gone"
                    app:isReadOnly="true"
                    app:hintText="저녁 알림(기본 18:00)"
                    app:iconSrc="@drawable/ic_time" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="투약 시간대 *"
                android:textColor="@color/g700"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_dosage_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="11dp"
                android:background="@drawable/bg_yellow_border"
                android:padding="2dp"
                android:weightSum="3">

                <RadioButton
                    android:id="@+id/rb_before"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="식전 30분"
                    android:button="@null"
                    android:background="@drawable/selector_square_check_box"
                    android:gravity="center"
                    android:layout_margin="2dp"
                    android:textSize="13sp"
                    android:textColor="@color/selector_square_check_box_text" />

                <RadioButton
                    android:id="@+id/rb_after"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="식후 30분"
                    android:button="@null"
                    android:background="@drawable/selector_square_check_box"
                    android:gravity="center"
                    android:layout_margin="2dp"
                    android:textSize="13sp"
                    android:textColor="@color/selector_square_check_box_text" />

                <RadioButton
                    android:id="@+id/rb_anytime"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="직후"
                    android:button="@null"
                    android:background="@drawable/selector_square_check_box"
                    android:gravity="center"
                    android:layout_margin="2dp"
                    android:textSize="13sp"
                    android:textColor="@color/selector_square_check_box_text" />

            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:background="@color/g100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:text="약 선택 *"
                android:textColor="@color/g900"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_selected_pills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_add_medication_setting"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_pill"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="약 추가"
                android:textAllCaps="false"
                android:textColor="@color/p600"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/white"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_lc_plus"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/p600"
                app:strokeColor="@color/p600"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:text="등록"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/g100"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
