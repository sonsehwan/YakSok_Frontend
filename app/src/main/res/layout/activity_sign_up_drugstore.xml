<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.signup.SignUp_DrugStore">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_yellow_pill"
        tools:ignore="MissingConstraints" />

    <com.example.medication.InputView
        android:id="@+id/input_email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:imeOptions="actionNext"
        android:inputType="textEmailAddress"
        android:nextFocusDown="@id/input_pw"
        app:helperText="연락 가능한 이메일 주소를 입력해주세요."
        app:hintText="이메일을 입력하세요."
        app:iconSrc="@drawable/ic_email"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:validationType="email" />

    <com.example.medication.InputView
        android:id="@+id/input_pw"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:imeOptions="actionNext"
        android:inputType="textPassword"
        android:nextFocusDown="@id/input_check_pw"
        app:helperText="8~16자의 영문, 숫자, 특수문자를 모두 포함해야 합니다."
        app:hintText="비밀번호를 입력하세요."
        app:iconSrc="@drawable/ic_lock"
        app:isPassword="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_email"
        app:validationType="password" />

    <com.example.medication.InputView
        android:id="@+id/input_check_pw"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nextFocusDown="@id/input_nickname"

        android:layout_marginHorizontal="20dp"
        android:inputType="textPassword"
        android:imeOptions="actionNext"
        app:validationType="password"
        app:hintText="비밀번호를 재입력하세요."
        app:helperText="비밀번호를 한 번 더 입력해주세요."
        app:iconSrc="@drawable/ic_lock_check"
        app:isPassword="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_pw" />

    <com.example.medication.InputView
        android:id="@+id/input_nickname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:imeOptions="actionDone"
        android:inputType="text"
        app:helperText="2~10자의 한글, 영문, 숫자만 사용 가능합니다."
        app:hintText="닉네임을 입력하세요."
        app:iconSrc="@drawable/ic_user"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_check_pw"
        app:validationType="nickname" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_find_drugstore"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/brand_icon"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_nickname">

        <LinearLayout
            android:id="@+id/ll_find_drugstore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="7dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_map"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="15dp"
                app:tint="@color/brand_icon"
                app:srcCompat="@drawable/ic_map" />

            <TextView
                android:id="@+id/tv_drugstore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:gravity="center_vertical"
                android:hint="약국을 등록하세요"
                android:textColorHint="#999999"
                android:textColor="@android:color/black"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_find_drugstore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/brand_surface"
                android:minWidth="60dp"
                android:minHeight="40dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:layout_marginRight="10dp"
                android:text="찾기"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sign_up"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginHorizontal="20dp"
        android:text="회원가입"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_surface"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mcv_find_drugstore" />

</androidx.constraintlayout.widget.ConstraintLayout>