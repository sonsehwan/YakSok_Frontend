<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 상단 툴바 영역 -->
    <TextView
        android:id="@+id/tv_room_name"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="상담방"
        android:textSize="21sp"
        android:textStyle="bold"
        android:background="@color/brand_surface"
        android:textColor="#222222"
        android:elevation="6dp" />

    <!-- 채팅 메시지 목록 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:clipToPadding="false"
        android:background="#FFFDE7"
        tools:listitem="@layout/item_my_yaksok_share_message"/>

    <!-- 하단 메시지 입력 영역 -->
    <LinearLayout
        android:id="@+id/layout_message_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginRight="5dp"
            android:layout_gravity="bottom"
            android:text="+"
            android:textSize="26sp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/bg_yellow"/>


        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:layout_weight="1"
            android:hint="메시지를 입력하세요"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_message_edittext"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minLines="1"
            android:textSize="16sp"
            android:textColor="#222222"
            android:textColorHint="#999999" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="전송"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_gravity="bottom"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            app:cornerRadius="20dp"
            app:backgroundTint="@color/brand_surface" />

    </LinearLayout>

</LinearLayout>